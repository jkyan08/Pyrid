# Copy to .env and fill in. .env is gitignored; never commit real values.

# Required for claim extraction, reconciliation, /explain and /draft.
OPENAI_API_KEY=

# Optional. NCBI E-utilities (PubMed, ClinVar) allow up to 3 requests/s without a key
# and up to 10 requests/s with one. The rate limiter in pipeline/cache.py reads this.
NCBI_API_KEY=

# Model names are never hard-coded (README hard rule 9). Check OpenAI's current docs
# for the chat model that supports structured outputs and for the embedding model.
OPENAI_MODEL=
OPENAI_EMBED_MODEL=

# Disk cache for every HTTP and LLM call, keyed by request hash.
# When several checkouts run in parallel, set this to one ABSOLUTE path so they all
# share a single cache (keys are hashes, so concurrent writers are safe).
ATLAS_CACHE_DIR=data/cache

# Where export.py writes the graph and where the API reads it from.
ATLAS_GRAPH_PATH=data/build/graph.json

# Large raw downloads (OptimusKG parquet, phenotype.hpoa, ...) land here, verified by checksum.
# Like ATLAS_CACHE_DIR, point parallel checkouts at one ABSOLUTE path so files download once.
ATLAS_RAW_DIR=data/raw
